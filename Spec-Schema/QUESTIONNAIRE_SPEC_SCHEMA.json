{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metastruct.io/schemas/questionnaire-spec.json",
  "title": "Questionnaire Specification Schema",
  "description": "Guided data-capture definition binding questions to entity fields, step sequences, and branching transitions.",
  "type": "object",
  "required": ["id", "title", "targetEntity", "questions", "steps", "initialStep", "transitions"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "targetEntity": { 
      "type": "string",
      "description": "Primary context entity for questionnaire execution."
    },
    "questions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "entityName", "fieldKey", "questionText"],
        "properties": {
          "id": { "type": "string" },
          "entityName": { "type": "string" },
          "fieldKey": { "type": "string" },
          "questionText": { "type": "string" },
          "helpText": { "type": ["string", "null"] },
          "placeholder": { "type": ["string", "null"] },
          "isRequired": { 
            "type": "boolean",
            "description": "Rule Q-005: Governs question mandate during questionnaire execution, independent of Entity property 'required'."
          },
          "readOnly": { "type": "boolean" },
          "widget": {
            "type": "object",
            "description": "Rule Q-006: Optional presentation override. If omitted, compiler cascades to UI Spec widget, then Metastruct default widget.",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "props": { "type": "object" }
            }
          }
        }
      }
    },
    "initialStep": { "type": "string" },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "title", "questionIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "questionIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visibilityCondition": {
            "type": ["object", "null"],
            "required": ["questionId", "operator", "value"],
            "properties": {
              "questionId": { "type": "string" },
              "operator": { 
                "type": "string",
                "enum": [
                  "equals",
                  "notEquals",
                  "contains",
                  "greaterThan",
                  "lessThan",
                  "in",
                  "notIn",
                  "exists",
                  "isTrue",
                  "isFalse"
                ] 
              },
              "value": { 
                "type": ["string", "number", "boolean", "array", "object", "null"] 
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
