{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metastruct.io/schemas/ui-spec.json",
  "title": "UI Specification Schema",
  "description": "CRUD presentation layout contract grouping entity fields into visual sections with technology-agnostic widget types.",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "title": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "fields"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "fields": {
            "type": "array",
            "items": {
              "oneOf": [
                { 
                  "type": "string", 
                  "description": "Key referencing entitySpec property." 
                },
                {
                  "type": "object",
                  "required": ["key"],
                  "properties": {
                    "key": { "type": "string" },
                    "label": { "type": ["string", "null"] },
                    "readOnly": { "type": "boolean" },
                    "widget": {
                      "type": "object",
                      "required": ["type"],
                      "properties": {
                        "type": { 
                          "type": "string",
                          "enum": [
                            "text",
                            "number",
                            "select",
                            "datepicker",
                            "checkbox",
                            "textarea",
                            "radio",
                            "custom"
                          ],
                          "description": "Rule UI-003: Abstract UI presentation token mapped by runtime renderers." 
                        },
                        "props": { "type": "object" }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
