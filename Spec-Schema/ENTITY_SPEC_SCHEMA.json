{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metastruct.io/schemas/entity-spec.json",
  "title": "Entity Specification Schema",
  "description": "Canonical business data model defining entity primary keys, property types, foreign key constraints, and relationships.",
  "type": "object",
  "required": ["title", "primaryKey", "properties"],
  "properties": {
    "title": { "type": "string" },
    "version": { "type": "string" },
    "primaryKey": { 
      "type": "string",
      "description": "DM-001 & DM-002: Property key acting as the unique identity (UID) for this entity."
    },
    "required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "default": { 
            "type": ["string", "number", "boolean", "array", "object", "null"] 
          },
          "minLength": { "type": "integer" },
          "maxLength": { "type": "integer" },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "pattern": { "type": "string" },
          "isForeignKey": { "type": "boolean" },
          "foreignEntity": { 
            "type": ["string", "null"],
            "description": "DM-004 & DM-005: Name of target entity this FK references."
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "description": "DM-006: Explicit entity-to-entity relationship mappings.",
      "items": {
        "type": "object",
        "required": ["name", "targetEntity", "type", "foreignKey"],
        "properties": {
          "name": { "type": "string" },
          "targetEntity": { "type": "string" },
          "type": { 
            "type": "string", 
            "enum": ["oneToOne", "oneToMany", "manyToOne", "manyToMany"] 
          },
          "foreignKey": { "type": "string" }
        }
      }
    }
  }
}
