{
  $id: "https://metastruct.io/schemas/entity-spec.json",
  type: "object",
  required: ["title", "properties"],
  properties: {
    title: { type: "string" },
    version: { type: "string" },
    required: {
      type: "array",
      items: { type: "string" }
    },
    properties: {
      type: "object",
      additionalProperties: {
        type: "object",
        properties: {
          type: { type: "string" },
          title: { type: "string" },
          default: { nullable: true },
          minLength: { type: "integer" },
          maxLength: { type: "integer" },
          minimum: { type: "number" },
          maximum: { type: "number" },
          pattern: { type: "string" }
        }
      }
    }
  }
