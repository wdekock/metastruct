{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metastruct.io/schemas/system-manifest.json",
  "title": "System Manifest Schema",
  "description": "Normalized runtime artifact produced by compiler containing schemas, layout, and complete questionnaire state.",
  "type": "object",
  "required": [
    "entityName",
    "version",
    "schema",
    "layout",
    "questionnaireState",
    "compiledAt"
  ],
  "properties": {
    "entityName": { "type": "string" },
    "version": { "type": "string" },
    "compiledAt": { 
      "type": "string",
      "format": "date-time"
    },
    "schema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["key", "type", "label", "required", "widget"],
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string" },
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "defaultValue": { "nullable": true },
          "widget": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "props": { "type": "object" }
            }
          },
          "validationRules": { "type": "object" }
        }
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "fields"],
        "properties": {
          "title": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/properties/schema/additionalProperties"
            }
          }
        }
      }
    },
    "questionnaireState": {
      "type": "object",
      "required": [
        "id",
        "title",
        "targetEntity",
        "initialStep",
        "questions",
        "steps",
        "allowedTransitions"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "targetEntity": { "type": "string" },
        "initialStep": { "type": ["string", "null"] },
        "questions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["id", "entityName", "fieldKey", "questionText", "widget"],
            "properties": {
              "id": { "type": "string" },
              "entityName": { "type": "string" },
              "fieldKey": { "type": "string" },
              "questionText": { "type": "string" },
              "helpText": { "type": ["string", "null"] },
              "isRequired": { "type": "boolean" },
              "readOnly": { "type": "boolean" },
              "widget": {
                "$ref": "#/properties/schema/additionalProperties/properties/widget"
              }
            }
          }
        },
        "steps": { "type": "object" },
        "allowedTransitions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
