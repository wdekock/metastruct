{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metastruct.io/schemas/system-manifest.json",
  "title": "System Manifest Schema",
  "description": "Immutable workspace runtime artifact generated by the compiler containing normalized entity schemas, SSOT layout field references, and step execution graph.",
  "type": "object",
  "required": [
    "systemId",
    "version",
    "compiledAt",
    "entities",
    "questionnaires"
  ],
  "properties": {
    "systemId": { "type": "string" },
    "version": { "type": "string" },
    "compiledAt": { 
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["entityName", "primaryKey", "schema", "layout"],
        "properties": {
          "entityName": { "type": "string" },
          "primaryKey": { "type": "string" },
          "schema": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["key", "type", "label", "required", "widget"],
              "properties": {
                "key": { "type": "string" },
                "type": { "type": "string" },
                "label": { "type": "string" },
                "required": { "type": "boolean" },
                "isPrimaryKey": { "type": "boolean" },
                "isForeignKey": { "type": "boolean" },
                "foreignEntity": { "type": ["string", "null"] },
                "defaultValue": { 
                  "type": ["string", "number", "boolean", "array", "object", "null"] 
                },
                "widget": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string" },
                    "props": { "type": "object" }
                  }
                },
                "validationRules": { "type": "object" }
              }
            }
          },
          "layout": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "fields"],
              "properties": {
                "title": { "type": "string" },
                "fields": {
                  "type": "array",
                  "description": "SSOT field keys referencing resolved properties in entity.schema.",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "questionnaires": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "title",
          "targetEntity",
          "initialStep",
          "questions",
          "steps",
          "allowedTransitions"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "targetEntity": { "type": "string" },
          "initialStep": { "type": "string" },
          "questions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["id", "entityName", "fieldKey", "questionText", "widget"],
              "properties": {
                "id": { "type": "string" },
                "entityName": { "type": "string" },
                "fieldKey": { "type": "string" },
                "questionText": { "type": "string" },
                "helpText": { "type": ["string", "null"] },
                "isRequired": { "type": "boolean" },
                "readOnly": { "type": "boolean" },
                "widget": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string" },
                    "props": { "type": "object" }
                  }
                }
              }
            }
          },
          "steps": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["id", "title", "questionIds"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "questionIds": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "visibilityCondition": {
                  "type": ["object", "null"],
                  "required": ["questionId", "operator", "value"],
                  "properties": {
                    "questionId": { "type": "string" },
                    "operator": { "type": "string" },
                    "value": { 
                      "type": ["string", "number", "boolean", "array", "object", "null"] 
                    }
                  }
                }
              }
            }
          },
          "allowedTransitions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
