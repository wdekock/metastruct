{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.entity.json",
  "title": "Layer 1 Entity Meta-Schema",
  "description": "Governs invariant entity structures, primary key standards, audit mixins, and relational contracts.",
  "type": "object",
  "required": [
    "title",
    "description",
    "properties",
    "required"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "title": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "description": { "type": "string" },
    "properties": {
      "type": "object",
      "required": ["id", "created_at", "created_by", "updated_at", "updated_by", "is_deleted"],
      "additionalProperties": {
        "$ref": "#/definitions/propertyDefinition"
      }
    },
    "required": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/linkDefinition"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "propertyDefinition": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "array", "object"]
        },
        "description": { "type": "string" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["date", "date-time", "email", "uuid", "uri"]
        },
        "enum": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean"] },
          "minItems": 1
        },
        "default": { "type": ["string", "number", "boolean", "null", "array", "object"] },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "items": { "type": "object" },
        "$ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "linkDefinition": {
      "type": "object",
      "required": ["targetEntity", "cardinality", "foreignKey"],
      "properties": {
        "targetEntity": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]+$"
        },
        "cardinality": {
          "type": "string",
          "enum": ["belongs_to", "has_many", "many_to_many"]
        },
        "foreignKey": {
          "type": "string",
          "pattern": "^[a-z0-9_]+_id$"
        },
        "junctionTable": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
