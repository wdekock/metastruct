{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.ui.json",
  "title": "Layer 2 UI Presentation Meta-Schema",
  "description": "Governs Material UI component selection, 12-column responsive grid positioning, masks, and field formatting.",
  "type": "object",
  "required": [
    "targetEntity",
    "layoutDensity",
    "fields"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "targetEntity": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "layoutDensity": {
      "type": "string",
      "enum": ["compact", "standard", "comfortable"]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fieldMapping"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "gridSpan": {
      "type": "object",
      "properties": {
        "xs": { "type": "integer", "minimum": 1, "maximum": 12 },
        "sm": { "type": "integer", "minimum": 1, "maximum": 12 },
        "md": { "type": "integer", "minimum": 1, "maximum": 12 },
        "lg": { "type": "integer", "minimum": 1, "maximum": 12 },
        "xl": { "type": "integer", "minimum": 1, "maximum": 12 }
      },
      "additionalProperties": false
    },
    "optionItem": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["string", "number", "boolean"] }
      },
      "additionalProperties": false
    },
    "fieldMapping": {
      "type": "object",
      "required": ["label", "widget"],
      "properties": {
        "label": { "type": "string" },
        "widget": {
          "type": "string",
          "enum": [
            "MuiTextField",
            "MuiDatePicker",
            "MuiAutocomplete",
            "MuiCheckbox",
            "MuiSwitch",
            "MuiSelect",
            "MuiInlineTable"
          ]
        },
        "required": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "placeholder": { "type": "string" },
        "helperText": { "type": "string" },
        "inputMask": { "type": "string" },
        "gridSpan": { "$ref": "#/definitions/gridSpan" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/optionItem" }
        },
        "linkRef": { "type": "string" },
        "validationRules": {
          "type": "object",
          "properties": {
            "customPattern": { "type": "string" },
            "errorMessage": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
