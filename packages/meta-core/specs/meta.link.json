{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.link.json",
  "title": "Layer 3 Link & Guardrail Meta-Schema",
  "description": "Governs build-time compilation guardrails, cross-entity foreign key integrity, ORM lookup queries, and UI field bindings across Layer 1 and Layer 2.",
  "type": "object",
  "required": [
    "linkGuardrailId",
    "sourceEntity",
    "targetEntity",
    "foreignKey",
    "cardinality"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "linkGuardrailId": {
      "type": "string",
      "pattern": "^link_[a-z0-9_]+$"
    },
    "sourceEntity": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "targetEntity": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "foreignKey": {
      "type": "string",
      "pattern": "^[a-z0-9_]+_id$"
    },
    "cardinality": {
      "type": "string",
      "enum": ["belongs_to", "has_many", "many_to_many"]
    },
    "cascadeDelete": {
      "type": "boolean",
      "default": false
    },
    "lookupQuery": {
      "type": "object",
      "required": ["displayLabelField", "valueField"],
      "properties": {
        "displayLabelField": { "type": "string" },
        "valueField": { "type": "string", "default": "id" },
        "filterCriteria": {
          "type": "object",
          "additionalProperties": { "type": ["string", "boolean", "number"] }
        }
      },
      "additionalProperties": false
    },
    "uiBindingRef": { "type": "string" }
  },
  "additionalProperties": false
}