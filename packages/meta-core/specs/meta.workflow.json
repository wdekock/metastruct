{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.workflow.json",
  "title": "Layer 4 Workflow & Process Meta-Schema",
  "description": "Governs multi-step orchestration, prerequisites, RACI roles, and dynamic step conditions.",
  "type": "object",
  "required": [
    "workflowId",
    "title",
    "targetEntity",
    "steps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+_workflow$"
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "targetEntity": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$"
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/workflowStep" },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "definitions": {
    "stepCondition": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "type": "string" },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "contains", "greater_than", "is_true", "is_false"]
        },
        "value": { "type": ["string", "number", "boolean"] }
      },
      "additionalProperties": false
    },
    "raciAssignment": {
      "type": "object",
      "required": ["responsible", "accountable"],
      "properties": {
        "responsible": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "accountable": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "consulted": { "type": "array", "items": { "type": "string" } },
        "informed": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "workflowStep": {
      "type": "object",
      "required": ["stepId", "title", "fields"],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^step_[a-z0-9_]+$"
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dependsOnSteps": {
          "type": "array",
          "items": { "type": "string", "pattern": "^step_[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/stepCondition" }
        },
        "fields": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "raci": { "$ref": "#/definitions/raciAssignment" }
      },
      "additionalProperties": false
    }
  }
}
