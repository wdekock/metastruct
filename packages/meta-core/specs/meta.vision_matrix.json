{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta.vision_matrix.json",
  "title": "Layer 0 Vision Matrix Meta-Schema",
  "description": "Governs spatial density, responsive viewport breakpoints, layout constraints, and component sizing bounds across the architecture.",
  "type": "object",
  "required": [
    "matrixId",
    "breakpoints",
    "viewportBounds",
    "densityProfiles",
    "gridColumns"
  ],
  "properties": {
    "matrixId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "description": { "type": "string" },
    "gridColumns": {
      "type": "integer",
      "enum": [12]
    },
    "breakpoints": {
      "type": "object",
      "required": ["xs", "sm", "md", "lg", "xl"],
      "properties": {
        "xs": { "type": "integer", "minimum": 0, "maximum": 599 },
        "sm": { "type": "integer", "minimum": 600, "maximum": 899 },
        "md": { "type": "integer", "minimum": 900, "maximum": 1199 },
        "lg": { "type": "integer", "minimum": 1200, "maximum": 1535 },
        "xl": { "type": "integer", "minimum": 1536 }
      },
      "additionalProperties": false
    },
    "viewportBounds": {
      "type": "object",
      "required": ["maxFormWidth", "modalMaxHeight", "minTouchTargetPx"],
      "properties": {
        "maxFormWidth": { "type": "integer", "minimum": 600, "maximum": 1920 },
        "modalMaxHeight": { "type": "string", "pattern": "^[0-9]+(px|vh|%)$" },
        "minTouchTargetPx": { "type": "integer", "minimum": 32, "maximum": 64 }
      },
      "additionalProperties": false
    },
    "densityProfiles": {
      "type": "object",
      "required": ["compact", "standard", "comfortable"],
      "properties": {
        "compact": { "$ref": "#/definitions/densityConfig" },
        "standard": { "$ref": "#/definitions/densityConfig" },
        "comfortable": { "$ref": "#/definitions/densityConfig" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "densityConfig": {
      "type": "object",
      "required": ["rowSpacing", "fieldMargin", "inputSize", "tablePadding"],
      "properties": {
        "rowSpacing": { "type": "integer", "minimum": 1, "maximum": 6 },
        "fieldMargin": { "type": "string", "enum": ["none", "dense", "normal"] },
        "inputSize": { "type": "string", "enum": ["small", "medium"] },
        "tablePadding": { "type": "string", "enum": ["checkbox", "dense", "normal"] }
      },
      "additionalProperties": false
    }
  }
}