{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address",
  "version": "1.0.0",
  "primaryKey": "address_id",
  "required": ["address_id", "address_type_id", "line1", "city", "postal_code", "country"],
  "properties": {
    "address_id": {
      "type": "uid",
      "title": "Address ID"
    },
    "address_type_id": {
      "type": "uid",
      "title": "Address type ID",
      "isForeignKey": true,
      "foreignEntity": "AddressType"
    },
    "line1": {
      "type": "string",
      "title": "Address line 1",
      "minLength": 1
    },
    "line2": {
      "type": "string",
      "title": "Address line 2"
    },
    "city": {
      "type": "string",
      "title": "City",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "title": "State or province"
    },
    "postal_code": {
      "type": "string",
      "title": "Postal code",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "title": "Country",
      "minLength": 2
    }
  },
  "relationships": [
    {
      "name": "addressType",
      "targetEntity": "AddressType",
      "type": "manyToOne",
      "foreignKey": "address_type_id"
    },
    {
      "name": "clientAddresses",
      "targetEntity": "ClientAddress",
      "type": "oneToMany",
      "foreignKey": "address_id"
    }
  ]
}
