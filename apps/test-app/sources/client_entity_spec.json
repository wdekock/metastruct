{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client",
  "version": "1.0.0",
  "primaryKey": "client_id",
  "required": ["client_id", "name"],
  "properties": {
    "client_id": {
      "type": "uid",
      "title": "Client ID"
    },
    "name": {
      "type": "string",
      "title": "Client name",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "title": "Email"
    }
  },
  "relationships": [
    {
      "name": "clientAddresses",
      "targetEntity": "ClientAddress",
      "type": "oneToMany",
      "foreignKey": "client_id"
    }
  ]
}
